#!/usr/bin/env bash
# Blocks a commit that stages a local-only file or a line holding a privacy marker.
set -u
main=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
markers="$main/.privacy-markers.txt"
rc=0
staged=$(git diff --cached --name-only --diff-filter=AMR)
for f in listing.jsonl code-transcript.jsonl aliases.json .privacy-markers.txt; do
  if printf '%s\n' "$staged" | grep -qx ".*$f"; then echo "pre-commit: $f is local-only, unstage it"; rc=1; fi
done
if [ -s "$markers" ]; then
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    if git diff --cached -U0 | grep '^+' | grep -q -F -e "$m"; then echo "pre-commit: staged text contains a privacy marker: $m"; rc=1; fi
  done < "$markers"
else
  echo "pre-commit: no $markers, marker scan skipped"
fi
exit $rc
